# Analytics — each provider loads only when its ID is set
VITE_GA_ID=            # Google Analytics 4, e.g. G-XXXXXXXXXX
VITE_LINKEDIN_PARTNER_ID=  # LinkedIn Insight Tag partner ID, e.g. 1234567
VITE_META_PIXEL_ID=    # Meta (Facebook/Instagram) Pixel ID

# Leads — option A (recommended if you already use Zapier/Make/Formspree):
# VITE_LEAD_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Leads — option B (default): FormSubmit emails this inbox automatically.
# First submission asks you to confirm the address once via email from FormSubmit.
VITE_LEAD_EMAIL=admin@agentixvanguard.com
